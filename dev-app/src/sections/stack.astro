---
import { stack } from "../data/stack";
---

<section id="stack">
    <h2 class="mb-4">Stack</h2>

    <div class="row g-4">
        {
            stack.map((category) => (
                <div class="col-12 col-lg-6">
                    <h3 class="mb-3">{category.category}</h3>

                    <div class="d-flex flex-wrap gap-3">
                        {category.technologies.map((technology) => (
                            <div
                                class="d-flex flex-column align-items-center justify-content-center text-center"
                                style="width: 80px;"
                            >
                                <div
                                    class="rounded-circle border d-flex align-items-center justify-content-center mb-2"
                                    style="width: 58px; height: 58px;"
                                >
                                    <i class={`${technology.icon} fs-4`} />
                                </div>

                                <span class="small">{technology.name}</span>
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</section>
