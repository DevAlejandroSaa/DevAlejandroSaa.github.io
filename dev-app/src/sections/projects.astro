---
import { projects } from "../data/projects";
---

<section id="proyectos">
    <h2>Proyectos</h2>

    {
        projects.map((project) => (
            <article>
                <h3>{project.name}</h3>

                <p>{project.description}</p>

                <ul>
                    {project.technologies.map((technology) => (
                        <li>{technology}</li>
                    ))}
                </ul>

                <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    GitHub
                </a>
            </article>
        ))
    }
</section>
