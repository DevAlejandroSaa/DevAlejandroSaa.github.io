---
interface Props {
    id: string;
    name: string;
    label: string;
    type?: "text" | "email" | "password";
    required?: boolean;
}

const { id, name, label, type = "text", required = false } = Astro.props;
---

<div class="mb-3">
    <label for={id} class="form-label">{label}</label>
    <input
        type={type}
        id={id}
        name={name}
        class="form-control"
        required={required}
    />
</div>
